# Supabase (public — safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (server-only, bypasses RLS — used by admin/invite-employee route)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret for local cryptographic verification in edge middleware
SUPABASE_JWT_SECRET=

# Shared secret for scheduled keep-alive ping daemon
CRON_SECRET=

# Anthropic Claude (AI schedule generation, GDPR + labor law route)
ANTHROPIC_API_KEY=

# OpenAI (alternative AI schedule generation route)
OPENAI_API_KEY=

# OpenWeather (weather forecast context for scheduling; optional — falls back to mock data)
OPENWEATHER_API_KEY=
